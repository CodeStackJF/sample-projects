@{
    Layout = "_LayoutLogin";
    List<Users> users = ViewBag.Users;
}
<img src="~/img/logo.png" height="100" />
<div class="row">
    <div class="col-md-12">
        @foreach(Users user in users)
        {
            <div class="card">
                <div class="card-body">
                    <div class="card-title">@user.name</div>
                    <div class="card-text">
                        <div class="col-md-3">
                            <label>Address</label>
                            <p>@user.address</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.Partial("~/Views/Users/Partial/_UserTemplate.cshtml")